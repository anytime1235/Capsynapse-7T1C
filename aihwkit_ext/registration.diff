+      m, NAME("CapSynapseResistiveDeviceParameter"))
+      .def(py::init<>())
+      .def_readwrite("shared_transistor", &CapSynapseParam::shared_transistor)
+      .def_readwrite("vdd", &CapSynapseParam::vdd)
+      .def_readwrite("vov_median", &CapSynapseParam::vov_median)
+      .def_readwrite("vov_std", &CapSynapseParam::vov_std)
+      .def_readwrite("lam", &CapSynapseParam::lam)
+      .def_readwrite("lam_rel_std", &CapSynapseParam::lam_rel_std)
+      .def_readwrite("lam_scale", &CapSynapseParam::lam_scale)
+      .def_readwrite("w_rel_std", &CapSynapseParam::w_rel_std)
+      .def_readwrite("bound_std", &CapSynapseParam::bound_std)
+      .def_readwrite("step_median", &CapSynapseParam::step_median)
+      .def_readwrite("hs_gamma", &CapSynapseParam::hs_gamma)
+      .def_readwrite("hs_pulse_scheduling", &CapSynapseParam::hs_pulse_scheduling)
+      .def_readwrite("hs_ps_group", &CapSynapseParam::hs_ps_group)
+      .def(
+          "__str__",
+          [](CapSynapseParam &self) {
+            std::stringstream ss;
+            self.printToStream(ss);
+            return ss.str();
+          })
+      .def(
+          "calc_weight_granularity", &CapSynapseParam::calcWeightGranularity,
+          R"pbdoc(
+        Calculates the granularity of the weights (2 / step_median)
+
+        Returns:
+           float: weight granularity
+        )pbdoc");
+
