+      PYBIND11_OVERLOAD(RPU::DeviceUpdateType, CapSynapseParam, implements, );
+    }
+    RPU::CapSynapseRPUDevice<T> *
+    createDevice(int x_size, int d_size, RPU::RealWorldRNG<T> *rng) override {
+      PYBIND11_OVERLOAD(
+          RPU::CapSynapseRPUDevice<T> *, CapSynapseParam, createDevice, x_size, d_size, rng);
+    }
+    T calcWeightGranularity() const override {
+      PYBIND11_OVERLOAD(T, CapSynapseParam, calcWeightGranularity, );
