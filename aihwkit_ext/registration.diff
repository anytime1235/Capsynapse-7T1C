diff --git a/src/aihwkit/simulator/configs/devices.py b/src/aihwkit/simulator/configs/devices.py
index 01da44c..899bfc2 100644
--- a/src/aihwkit/simulator/configs/devices.py
+++ b/src/aihwkit/simulator/configs/devices.py
@@ -1239,3 +1239,61 @@ class PiecewiseStepDevice(PulsedDevice):
     If ``False`` the persistent weight state will be equal to the
     apparent state initially.
     """
+
+
+@dataclass
+class CapSynapseDevice(PulsedDevice):
+    r"""6T1C / 7T1C capacitor-based synapse with transistor-level variation.
+
+    Weights are ``w = G - G_ref`` with the per-cell reference at ``V_cap = 0``
+    (nominal bounds ``[-1, 1]``). The update step is piecewise linear in the
+    conductance, with the saturation/linear transition of the update transistor at
+    ``G_max - R*beta`` (potentiation) and ``G_min + R*beta`` (depression).
+    ``shared_transistor=False`` is the 6T1C (N2 and N4), ``True`` the 7T1C (N7).
+    ``dw_min``, ``w_max`` and ``w_min`` are set by ``step_median`` and ``bound_std``.
+    """
+
+    bindings_class: ClassVar[Optional[Union[Type, str]]] = "CapSynapseResistiveDeviceParameter"
+
+    shared_transistor: bool = False
+    """False: 6T1C, True: 7T1C."""
+
+    dw_min_std: float = 0.0
+    """Cycle-to-cycle noise of the update step."""
+
+    vdd: float = 3.0
+    """Supply voltage (V); V_cap spans [-vdd/2, vdd/2]."""
+
+    vov_median: float = 0.35
+    """Median overdrive voltage of the update transistor (V)."""
+
+    vov_std: float = 0.043
+    """Std of the overdrive voltage (V)."""
+
+    lam: float = 0.0324
+    """Channel-length modulation (1/V)."""
+
+    lam_rel_std: float = 1.0 / 30.0
+    """7T1C: relative std of lam_pot and lam_dep (sampled separately)."""
+
+    lam_scale: float = 1.5
+    """Volts per weight unit in the lam term (1 weight unit = 4.5 uS = 1.5 V)."""
+
+    w_rel_std: float = 1.0 / 30.0
+    """Relative std of the channel width."""
+
+    bound_std: float = 0.15 / 4.5
+    """Std of G_max and G_min in weight units."""
+
+    step_median: float = 1000.0
+    """Number of states of the median cell over the full range."""
+
+    hs_gamma: float = 0.0
+    """Write-disturbance decay per CP<->CN node-group transition, w <- (1 - gamma) w.
+    0 disables it. CUDA only."""
+
+    hs_pulse_scheduling: bool = True
+    """All potentiation of one image before any depression."""
+
+    hs_ps_group: float = 0.0
+    """Mat-vecs per image (H_out * W_out of a conv layer) for pulse scheduling."""
